rules_version = '2';

// PakJobs Daily. Everyone starts as an anonymous (guest) Firebase account; posting and commenting
// need a Google or email/password login. Admins are uids listed in /admins.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function notBanned() { return !exists(/databases/$(database)/documents/banned/$(me())); }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function data() { return request.resource.data; }

    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false; // granted from the console / scripts only
    }

    match /banned/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid
        && str(data().name, 2, 60) && str(data().whatsapp, 0, 20);
      allow delete: if signedIn() && me() == uid;
    }

    // Private job posts: created as "pending", only an admin can approve or feature them.
    match /posts/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && (resource.data.ownerUid == me() || isAdmin()));

      allow create: if realUser() && notBanned()
        && data().ownerUid == me()
        // admins may publish directly; everyone else starts as pending
        && (data().status == 'pending' || (isAdmin() && data().status == 'approved'))
        && data().featured == false
        && data().featureRequested is bool
        && str(data().title, 3, 120)
        && str(data().company, 2, 120)
        && str(data().city, 2, 60)
        && str(data().description, 10, 3000)
        && str(data().phone, 0, 20) && str(data().whatsapp, 0, 20)
        && data().createdAt == request.time
        && data().expiresAt <= request.time + duration.value(31, 'd');

      // owners may only ask for "featured"; everything else is the admin's
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == me()
            && data().diff(resource.data).affectedKeys().hasOnly(['featureRequested'])
            && data().featureRequested == true);

      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == me());
    }

    // Comments on any job (government or private), keyed by the app's job id.
    match /threads/{jobId}/comments/{cid} {
      allow read: if true;
      allow create: if realUser() && notBanned()
        && data().uid == me()
        && str(data().name, 1, 60)
        && str(data().text, 1, 500)
        && data().createdAt == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == me());
    }

    // lets "delete my account" find a user's comments across all threads
    match /{path=**}/comments/{cid} {
      allow read: if true;
    }

    // ---- Imtihan Hub (separate exam-prep app, same Firebase project) - opt-in weekly leaderboards.
    // Weekly points: one doc per student per ISO week, points may only go up.
    match /imtihan_points/{week}/u/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid
        && week.matches('^20[0-9]{2}-W[0-9]{2}$')
        && data().keys().hasOnly(['name', 'points', 'tests', 'at'])
        && str(data().name, 2, 30)
        && data().points is int && data().points >= 0 && data().points <= 5000
        && data().tests is int && data().tests >= 0 && data().tests <= 500
        && data().at == request.time
        && (resource == null || data().points >= resource.data.points);
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }
    // Weekly grand test: only the first attempt counts, so it can be created but never changed.
    match /imtihan_grand/{gid}/u/{uid} {
      allow read: if true;
      allow create: if signedIn() && me() == uid
        && gid.matches('^20[0-9]{2}-W[0-9]{2}-(medical|engineering|general)$')
        && data().keys().hasOnly(['name', 'score', 'total', 'seconds', 'at'])
        && str(data().name, 2, 30)
        && data().total is int && data().total >= 1 && data().total <= 200
        && data().score is int && data().score >= 0 && data().score <= data().total
        && data().seconds is int && data().seconds >= 0 && data().seconds <= 20000
        && data().at == request.time;
      allow update: if false;
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    match /reports/{id} {
      allow create: if signedIn() && data().uid == me() && str(data().reason, 1, 200)
        && data().kind in ['job', 'comment'];
      allow read, delete: if isAdmin();
    }
  }
}
