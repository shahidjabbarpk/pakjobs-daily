    "@react-native-google-signin/google-signin": "^17.0.0",
    "@types/react": "~19.2.4",
    "expo": "~57.0.30",
    "expo-background-task": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
