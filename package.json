{
  "name": "pakjobs-daily",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "scrape": "python scraper/scrape.py",
    "seed": "node scripts/make-seed.js",
    "apk": "node scripts/make-seed.js && expo prebuild --platform android --clean && cd android && gradlew.bat app:assembleRelease",
    "aab": "node scripts/make-seed.js && expo prebuild --platform android --clean && cd android && gradlew.bat app:bundleRelease"
  },
  "dependencies": {
